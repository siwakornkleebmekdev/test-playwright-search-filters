{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "Professional Test-Case & Markdown driven Playwright Automation Framework (JavaScript)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:search": "playwright test tests/e2e/search",
    "test:tc": "playwright test --grep",
    "robot:install": "python -m pip install -r requirements-robot.txt && rfbrowser init chromium",
    "test:robot": "node scripts/run-robot.js",
    "test:robot:tc": "node scripts/run-robot.js",
    "test:all": "npm test && npm run test:robot"
  },
  "keywords": [
    "playwright",
    "javascript",
    "automation",
    "testing",
    "e2e",
    "search-filter",
    "page-object-model"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "dotenv": "^16.4.7"
  }
}
